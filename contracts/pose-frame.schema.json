{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posey.local/contracts/pose-frame.schema.json",
  "title": "Posey PoseFrame",
  "description": "Native vision output consumed by the shared scoring and coaching engine. Coordinates are normalized to the upright preview image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "timestampMs",
    "imageSize",
    "orientation",
    "people",
    "camera",
    "quality"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "timestampMs": { "type": "integer", "minimum": 0 },
    "imageSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "orientation": {
      "enum": ["portrait", "portraitUpsideDown", "landscapeLeft", "landscapeRight"]
    },
    "people": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/person" }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lens", "rollDeg", "pitchDeg", "motionScore"],
      "properties": {
        "lens": { "enum": ["front", "wide", "main", "telephoto", "unknown"] },
        "focalLength35mm": { "type": "number", "exclusiveMinimum": 0 },
        "rollDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "pitchDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "motionScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "subjectDistanceM": { "type": "number", "exclusiveMinimum": 0 },
        "subjectDistanceConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisLatencyMs", "droppedFrames", "thermalState"],
      "properties": {
        "analysisLatencyMs": { "type": "number", "minimum": 0 },
        "droppedFrames": { "type": "integer", "minimum": 0 },
        "thermalState": { "enum": ["nominal", "fair", "serious", "critical", "unknown"] }
      }
    },
    "captureGates": {
      "description": "Optional quality-gate output. It remains optional until the native analyzers are implemented; absence must never be interpreted as pass.",
      "type": "object",
      "additionalProperties": false,
      "required": ["crop", "motion", "faceLight"],
      "properties": {
        "crop": { "$ref": "#/$defs/qualityGateResult" },
        "motion": { "$ref": "#/$defs/qualityGateResult" },
        "faceLight": { "$ref": "#/$defs/qualityGateResult" }
      }
    }
  },
  "$defs": {
    "qualityGateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "confidence", "reasonCode", "metrics", "timestampMs"],
      "properties": {
        "state": { "enum": ["pass", "warning", "block", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 80 },
        "metrics": {
          "type": "object",
          "description": "Local diagnostic scalars such as minimum edge distance, motion score, luminance percentiles, black clipping, and detail. Never include image pixels or identity data.",
          "additionalProperties": { "type": "number" }
        },
        "timestampMs": { "type": "integer", "minimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "confidence"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "confidence", "bounds", "landmarks"],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bounds": { "$ref": "#/$defs/rect" },
        "landmarks": {
          "type": "object",
          "description": "Canonical landmark name to normalized point. Platform-specific landmarks must be mapped before crossing the native boundary.",
          "additionalProperties": { "$ref": "#/$defs/point" }
        },
        "faceBounds": { "$ref": "#/$defs/rect" },
        "segmentationConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "faceLuminance": { "type": "number", "minimum": 0, "maximum": 1 },
        "faceLeftRightLightRatio": { "type": "number", "minimum": 0 }
      }
    }
  }
}
